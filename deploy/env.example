# SickleGuard instance settings. `sickleguard --instance <name> init` copies this to deploy/<name>.env and fills
# the secrets (hidden prompt for the OpenAI key). Never commit deploy/*.env, never paste them anywhere, and change
# single keys with `sickleguard env set KEY` (edits in place, keeps a .bak) instead of rewriting the file.
ENVIRONMENT=production
PUBLIC_URL=https://sickleguard.kasadaai.com
DOMAIN=sickleguard.kasadaai.com
ACME_EMAIL=
# Web container port on the host (nginx: app + /api). One per instance; init picks a free one.
WEB_PORT=8310
WEB_BIND=127.0.0.1
# HTTPS: auto | own (our Caddy on 80/443) | external (an existing proxy; `sickleguard edge snippet`)
EDGE_MODE=auto

OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small

POSTGRES_USER=sg
POSTGRES_DB=sickleguard
POSTGRES_PASSWORD=
JWT_SECRET=
MCP_TOKEN=
ADMIN_EMAIL=admin@sickleguard.local
ADMIN_PASSWORD=
# Fictional demo patients on an empty database, and the password of the demo accounts (empty = none).
# Keep false on live.
SEED_DEMO=false
DEMO_PASSWORD=
# Simulated wearable/device readings. Keep false on live.
SIMULATE_DEVICES=false
