# SickleGuard production settings. `scripts/sg init` copies this to deploy/.env and fills the secrets.
# Never commit deploy/.env.
ENVIRONMENT=production
PUBLIC_URL=https://sickleguard.example.com
DOMAIN=sickleguard.example.com
ACME_EMAIL=admin@example.com
WEB_PORT=8310

OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small

POSTGRES_USER=sg
POSTGRES_DB=sickleguard
POSTGRES_PASSWORD=
JWT_SECRET=
MCP_TOKEN=
ADMIN_EMAIL=admin@sickleguard.local
ADMIN_PASSWORD=
# Fictional demo patients on first start (set false for a clean install)
SEED_DEMO=true
