#!/usr/bin/env bash
# SickleGuard server control: thin wrapper around the sickleguard CLI (cli/). `scripts/sg help` lists commands.
# Old commands still work: `sg up` = `sickleguard deploy`, `sg edge` = `sickleguard edge up`, `sg test` runs the
# API tests in the image.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export SG_DIR="${SG_DIR:-$ROOT}"

bin=""
for c in "$ROOT/cli/dist/sickleguard" "$(command -v sickleguard 2>/dev/null || true)"; do
  [ -n "$c" ] && [ -x "$c" ] && { bin="$c"; break; }
done
if [ -z "$bin" ]; then
  if command -v go >/dev/null 2>&1; then
    echo "==> building the sickleguard CLI (make -C cli build)" >&2
    make -C "$ROOT/cli" build >/dev/null && bin="$ROOT/cli/dist/sickleguard"
  else
    echo "The sickleguard CLI is not installed. Install it (and Go if needed) with:" >&2
    echo "  cli/install.sh" >&2
    exit 1
  fi
fi

case "${1:-}" in
  up) shift; exec "$bin" deploy "$@" ;;
  edge) [ $# -eq 1 ] && exec "$bin" edge up ;;
  test)
    shift
    env="$ROOT/deploy/${SG_INSTANCE:-live}.env"
    exec docker compose -p "sg-${SG_INSTANCE:-live}" --env-file "$env" -f "$ROOT/deploy/docker-compose.yml" \
      run --rm --no-deps -v "$ROOT/api/tests:/app/tests:ro" api sh -c "uv sync --frozen -q --group dev && python -m pytest -q" ;;
  "") exec "$bin" --help ;;
esac
exec "$bin" "$@"
